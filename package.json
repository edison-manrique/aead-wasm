{
  "name": "aead-wasm",
  "version": "1.1.0",
  "description": "AEAD ChaCha20-Poly1305 / XChaCha20-Poly1305 ultra-rápido en WebAssembly (AssemblyScript): ~1M ops/s, ~300 MB/s en streaming de archivos, zero-alloc (0% GC), verificación de tags constant-time y cifrado in-place. RFC 8439.",
  "author": "Edison Manrique",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "asbuild": "asc assembly/index.ts --target release",
    "asbuild:debug": "asc assembly/index.ts --target debug",
    "build:ts": "esbuild src/index.ts --bundle --format=esm --minify --platform=browser --outfile=dist/index.js && tsc --emitDeclarationOnly",
    "build:app": "vite build",
    "build": "npm run asbuild && npm run build:ts && npm run build:app",
    "dev": "vite --host 0.0.0.0 --port 3000",
    "start": "tsx examples/server.ts",
    "lint": "tsc --noEmit && tsc -p playground/tsconfig.json --noEmit",
    "typecheck": "tsc --noEmit && tsc -p playground/tsconfig.json --noEmit",
    "test": "node --test",
    "bench": "tsx test/bench.ts",
    "prepublishOnly": "npm run build",
    "examples": "vite --host 0.0.0.0 --port 3000"
  },
  "keywords": [
    "wasm",
    "webassembly",
    "assemblyscript",
    "typescript",
    "cryptography",
    "crypto",
    "security",
    "aead",
    "authenticated-encryption",
    "encryption",
    "decryption",
    "cipher",
    "stream-cipher",
    "chacha20",
    "xchacha20",
    "chacha20-poly1305",
    "xchacha20-poly1305",
    "poly1305",
    "hchacha20",
    "mac",
    "message-authentication-code",
    "rfc8439",
    "rfc-8439",
    "streaming",
    "file-encryption",
    "constant-time",
    "zero-alloc",
    "zero-gc",
    "high-performance",
    "isomorphic",
    "cross-platform",
    "symmetric"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/edison-manrique/aead-wasm.git"
  },
  "bugs": {
    "url": "https://github.com/edison-manrique/aead-wasm/issues"
  },
  "homepage": "https://github.com/edison-manrique/aead-wasm#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "assemblyscript": "^0.28.20",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "lucide-solid": "^1.77.0",
    "solid-js": "^1.9.18",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.17"
  }
}
